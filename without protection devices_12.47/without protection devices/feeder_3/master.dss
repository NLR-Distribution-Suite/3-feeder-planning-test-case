/* ############################# 3-feeder Planning test case #####################################*/
/* Developed By: Abodh Poudyal and Bryan Palmintier*/
/* Grid Planning and Analysis Center*/
/* National Laboratory of the Rockies*/

clear

New Circuit.three_feeder_planning_ckt_feeder3
Edit Vsource.source bus=fdr3_bus_bar_.1.2.3 pu=1.03 basekv=12.47 r1=1e-05 x1=1e-5 r0=1e-05 x0=1e-05 
New Line.source_connector bus1=fdr3_bus_bar_.1.2.3 bus2=source.1.2.3 length = 1e-5 units=kft r1=1e-05 x1=1e-5 r0=1e-05 x0=1e-05 phases=3

Redirect LineCode.dss
Redirect wiredata.dss
Redirect LineGeometry.dss
Redirect breaker.dss
Redirect NormallyClosedSwitches.dss
Redirect NormallyOpenSwitches.dss
Redirect Lines.dss
Redirect xfmr_code.dss
Redirect Transformers.dss
Redirect Loads.dss


! set normal feeder configuration
open line.fdr3_4_fdr3_11

! define simulation parameters
Set DefaultBaseFreq=60
Set VoltageBases=[12.47, 0.480, 0.208]
Calcv

new energymeter.meter1 element=line.source_connector

Set MaxControlIter=100

! solve the system
solve


