/* ########################################### FEEDER 3 ######################################################################## */
! connecting buses of feeder 3 to feeder 2
new Line.fdr3-fdr2 bus1=fdr3 bus2=fdr2 linecode=switch length=0.0001 switch=true units=km

! around the feeder trunk
new Line.fdr2_0-fdr2_1_sw bus1=fdr2_0 bus2=fdr2_1_sw linecode=switch length=0.0001 switch=true units=km 
new Line.fdr2_0-fdr2_7_sw bus1=fdr2_0 bus2=fdr2_7_sw linecode=switch length=0.0001 switch=true units=km 

! between lines and laterals
new Line.fdr2_3_sw-fdr2_4 bus1=fdr2_3_sw bus2=fdr2_4 linecode=switch length=0.0001 switch=true units=km 
new Line.fdr2_8_fdr2_8-1 bus1=fdr2_8 bus2=fdr2_8-1 linecode=switch length=0.0001 switch=true units=km
new Line.fdr2_9_fdr2_10 bus1=fdr2_9 bus2=fdr2_10 linecode=switch length=0.0001 switch=true units=km
new Line.fdr2_12_fdr2_13_sw bus1=fdr2_12 bus2=fdr2_13_sw linecode=switch length=0.0001 switch=true units=km
new Line.fdr2_12_fdr2_15_sw bus1=fdr2_12 bus2=fdr2_15_sw linecode=switch length=0.0001 switch=true units=km
