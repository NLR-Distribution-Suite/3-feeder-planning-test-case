New Circuit.cadet-testcase bus1=source pu=1.02 basekv=132 r1=1e-05 x1=1e-5 r0=1e-05 x0=1e-05


/* ########################################### LINECODES  FOR SWITCHES ###################################################################### */
New Linecode.switch nphases=3
~ rmatrix=[1e-05 0.0 0.0 | 0.0 1e-05 0.0 | 0.0 0.0 1e-05] 
~ xmatrix=[1e-05 0.0 0.0 | 0.0 1e-05 0.0 | 0.0 0.0 1e-05]
~ units=kft

! substation: We assume the connector is where the feeders get connected and this is the substation switch
New Line.source_connector bus1=source bus2=connector linecode=switch length=1e-05 
New Transformer.sub_feeder3 phases=3 windings=2 xhl=5 %loadloss=0.002 %noloadloss=0.002 buses=[connector fdr3] conns=[delta wye] kvs=[132 12.47] kvas=[2000 2000] %rs=[0.01 0.01]

! feeder 2 is connected with the transformer serving feeder 3
New Line.sub_feeder2 bus1=fdr3 bus2=fdr2 linecode=switch length=1e-05


! feeder 1 has its own transformer
New Transformer.sub_feeder1 phases=3 windings=2 xhl=5 %loadloss=0.002 %noloadloss=0.002 buses=[connector fdr1] conns=[delta wye] kvs=[132 12.47] kvas=[1000 1000] %rs=[0.01 0.01]