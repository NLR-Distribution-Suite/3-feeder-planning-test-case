/* ########################################### Tie switches ########################################################################*/
! connecting buses of feeder 2 to feeder 1
new Line.fdr2-fdr1 bus1=fdr2 bus2=fdr1 linecode=switch length=0.0001 switch=true units=km

! normally open switches
new line.fdr3_12_fdr2_12 bus1=fdr3_12 bus2=fdr2_12 linecode=switch length=0.0001 switch=true units=km
new line.fdr2_4_fdr1_11 bus1=fdr2_4 bus2=fdr1_11 linecode=switch length=0.0001 switch=true units=km