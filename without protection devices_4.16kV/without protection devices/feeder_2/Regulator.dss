
/* ########################################### FEEDER 3 ######################################################################## */
/* reference: PNNL 9500 Node system */ 

! Define three banks of single-phase regulators; each phase is controlled separately
! The regulating transformer is defined as a low-impedance, low-loss 2-winding, 1:1, Y-Y transformer to approximate an ideal regulator
! The control regulates winding 2

New Transformer.VREG_fdr2_A  phases=1  windings=2  buses=(fdr2.1, fdr2_0.1)  conns=(wye, wye)  kvs=(2.4, 2.4)  kvas=(2000, 2000)  xhl=0.1 %loadloss=.01 Wdg=2 Maxtap=1.1 Mintap=0.9 ppm=0 
New Transformer.VREG_fdr2_B  phases=1  windings=2  buses=(fdr2.2, fdr2_0.2)  conns=(wye, wye)  kvs=(2.4, 2.4)  kvas=(2000, 2000)  xhl=0.1 %loadloss=.01 Wdg=2 Maxtap=1.1 Mintap=0.9 ppm=0 
New Transformer.VREG_fdr2_C  phases=1  windings=2  buses=(fdr2.3, fdr2_0.3)  conns=(wye, wye)  kvs=(2.4, 2.4)  kvas=(2000, 2000)  xhl=0.1 %loadloss=.01 Wdg=2 Maxtap=1.1 Mintap=0.9 ppm=0 

New RegControl.VREG_fdr2_A  transformer=VREG_fdr2_A  winding=2 vreg=125  ptratio=20 band=2  reversible=yes revvreg=125 revband=2 revThreshold=50
New RegControl.VREG_fdr2_B  transformer=VREG_fdr2_B  winding=2 vreg=125  ptratio=20 band=2  reversible=yes revvreg=125 revband=2 revThreshold=50
New RegControl.VREG_fdr2_C  transformer=VREG_fdr2_C  winding=2 vreg=125  ptratio=20 band=2  reversible=yes revvreg=125 revband=2 revThreshold=50
