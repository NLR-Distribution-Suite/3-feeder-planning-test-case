new Line.fdr3_8_fdr3_8-1 bus1=fdr3_8 bus2=fdr3_8-1 linecode=switch length=0.0001 switch=true units=km
new Line.fdr3_9_fdr3_10 bus1=fdr3_9 bus2=fdr3_10 linecode=switch length=0.0001 switch=true units=km
new Line.fdr3_12_fdr3_13_sw bus1=fdr3_12 bus2=fdr3_13_sw linecode=switch length=0.0001 switch=true units=km
